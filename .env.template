# Copy to .env and fill in values. .env is gitignored — never commit real values here.
# Also read by docker-compose.yml (Docker Compose auto-loads .env from the same
# directory) for the POSTGRES_* variables below.

# SQLite (dev, no Postgres server needed)
# DB_URL=sqlite:///report_engine.db

# PostgreSQL (shared dev/prod DB, via docker-compose.yml)
POSTGRES_USER=examplelab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=report_engine
DB_URL=postgresql+psycopg2://examplelab:changeme@localhost:5432/report_engine
